# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Local SQLite database
# Leave blank to use backend/data/stationary-companion.db
DB_STORAGE_PATH=

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me

# Messaging (Twilio) - optional. Without these, SMS/WhatsApp run in simulated
# mode (logged, not actually sent). Fill in to send for real.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
