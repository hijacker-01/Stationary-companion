# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=marg_erp
DB_PORT=5432

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me

# Messaging (Twilio) - optional. Without these, SMS/WhatsApp run in simulated
# mode (logged, not actually sent). Fill in to send for real.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
